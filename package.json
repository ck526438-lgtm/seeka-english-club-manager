{
  "name": "seeka-english-club-manager",
  "version": "1.0.0",
  "description": "Seeka University — English Club Manager (application de bureau Windows)",
  "main": "main.js",
  "author": "Christ (ck526438-lgtm)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ci.seeka.englishclub",
    "productName": "Seeka English Club Manager",
    "files": ["main.js", "index.html", "css/**", "js/**", "assets/**", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Seeka English Club" },
    "portable": { "artifactName": "SeekaEnglishClub-Portable-${version}.exe" }
  }
}
